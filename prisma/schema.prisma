generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PENDING
  REVIEWED
}

model IncidentUpload {
  id            String       @id @default(cuid())
  fileName      String
  incidentCount Int
  originalJson  String
  reviewedJson  String?
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reviewedAt    DateTime?
}
